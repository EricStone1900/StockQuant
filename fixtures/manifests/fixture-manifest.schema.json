{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/fixtures/fixture-manifest.schema.json",
  "title": "FixtureManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureId",
    "fixtureVersion",
    "stageId",
    "status",
    "dataMode",
    "usageEligibility",
    "source",
    "createdAt",
    "files",
    "expectedAssertions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "fixtureVersion": { "type": "string", "minLength": 1 },
    "stageId": { "type": "string", "pattern": "^V[1-3]\\.[1-5]$" },
    "status": { "enum": ["DRAFT", "FROZEN", "RETIRED"] },
    "dataMode": { "enum": ["FIXTURE", "RECORDED", "REAL"] },
    "usageEligibility": { "enum": ["SIMULATION_ONLY", "RESEARCH_ONLY", "PRODUCTION_ELIGIBLE"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "license"],
      "properties": {
        "kind": { "enum": ["SYNTHETIC", "RECORDED", "USER_PROVIDED", "PROVIDER"] },
        "description": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": ["string", "null"], "format": "date-time" },
        "authorizationRef": { "type": "string", "minLength": 1 },
        "authorizationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "authorizedUse": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["RESEARCH", "SIMULATION"] }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mediaType", "schemaRef"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mediaType": { "type": "string", "minLength": 1 },
          "schemaRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expectedAssertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertionId", "description"],
        "properties": {
          "assertionId": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "dataMode": { "const": "FIXTURE" } }, "required": ["dataMode"] },
      "then": { "properties": { "source": { "properties": { "kind": { "const": "SYNTHETIC" } } } } }
    },
    {
      "if": { "properties": { "dataMode": { "enum": ["RECORDED", "REAL"] } }, "required": ["dataMode"] },
      "then": {
        "properties": {
          "source": {
            "required": ["authorizationRef", "authorizationSha256", "authorizedUse", "retrievedAt"],
            "properties": {
              "kind": { "enum": ["RECORDED", "USER_PROVIDED", "PROVIDER"] },
              "retrievedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "usageEligibility": { "const": "PRODUCTION_ELIGIBLE" } }, "required": ["usageEligibility"] },
      "then": {
        "properties": {
          "dataMode": { "const": "REAL" },
          "source": { "required": ["authorizationRef", "authorizedUse"] }
        }
      }
    }
  ]
}
