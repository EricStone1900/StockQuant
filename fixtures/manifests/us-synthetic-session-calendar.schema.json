{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/fixtures/us-synthetic-session-calendar.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "fixtureVersion", "calendarVersion", "dataMode", "usageEligibility", "market", "currency", "timeZone", "provenance", "sessions"],
  "properties": {
    "schemaVersion": { "const": "v1.3-us-synthetic-session-calendar-v1" },
    "fixtureId": { "const": "v1.3-us-synthetic-session-calendar" },
    "fixtureVersion": { "const": "v1.3-us-synthetic-session-1" },
    "calendarVersion": { "const": "v1.3-us-synthetic-session-1" },
    "dataMode": { "const": "FIXTURE" },
    "usageEligibility": { "const": "SIMULATION_ONLY" },
    "market": { "const": "US_EQUITY" },
    "currency": { "const": "USD" },
    "timeZone": { "const": "America/New_York" },
    "provenance": { "type": "string", "minLength": 1 },
    "sessions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sessionDate", "status"],
        "properties": {
          "sessionDate": { "type": "string", "format": "date" },
          "status": { "enum": ["TRADING", "CLOSED"] },
          "open": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
          "close": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "TRADING" } }, "required": ["status"] }, "then": { "required": ["open", "close"] } },
          { "if": { "properties": { "status": { "const": "CLOSED" } }, "required": ["status"] }, "then": { "not": { "anyOf": [{ "required": ["open"] }, { "required": ["close"] }] } } }
        ]
      }
    }
  }
}
