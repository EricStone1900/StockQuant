[Unit]
Description=Create and verify a quiesced StockQuant PostgreSQL and Artifact backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=stockquant-backup
Group=stockquant-backup
SupplementaryGroups=docker
WorkingDirectory=/opt/stockquant
EnvironmentFile=/etc/stockquant/backup.env
RuntimeDirectory=stockquant-backup
RuntimeDirectoryMode=0700
Environment=STOCKQUANT_BACKUP_LOCK_PATH=/run/stockquant-backup/paired.lock
ExecStart=/usr/bin/node /opt/stockquant/scripts/scheduled-paired-backup.mjs
TimeoutStartSec=5h
TimeoutStopSec=30m
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/stockquant/backups /run/stockquant-backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
