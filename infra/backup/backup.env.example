# Copy to /etc/stockquant/backup.env with mode 0600 and adjust only after
# identifying the exact Ubuntu deployment's database and Artifact volume.
STOCKQUANT_BACKUP_DIR=/var/lib/stockquant/backups
STOCKQUANT_BACKUP_DATABASE=stockquant_research
STOCKQUANT_BACKUP_ARTIFACT_VOLUME=stockquant_research_artifacts
STOCKQUANT_BACKUP_COMPOSE_FILE=/opt/stockquant/infra/compose/docker-compose.yml
STOCKQUANT_BACKUP_QUIESCE_HOOK=/usr/local/libexec/stockquant-quiesce-writers
STOCKQUANT_BACKUP_RESUME_HOOK=/usr/local/libexec/stockquant-resume-writers
STOCKQUANT_BACKUP_LOCK_PATH=/run/stockquant-backup/paired.lock
# Optional, immutable local helper image required by backup:create.
# STOCKQUANT_BACKUP_HELPER_IMAGE=sha256:<locally-built-image-digest>
STOCKQUANT_BACKUP_TIMEOUT_MS=14400000
