{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/replay/historical-replay-command.schema.json",
  "title": "HistoricalReplayCommand",
  "type": "object", "additionalProperties": false,
  "required": ["testRunId", "namespace", "ownerId", "scenarioId", "seed", "bar"],
  "properties": {
    "testRunId": { "type": "string", "format": "uuid" },
    "namespace": { "type": "string", "minLength": 1, "maxLength": 512 },
    "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scenarioId": { "enum": ["normal", "recovery"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "bar": { "$ref": "historical-replay-bar.schema.json" }
  }
}
