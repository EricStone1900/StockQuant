{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/replay/historical-replay-bar.schema.json",
  "title": "HistoricalReplayBar",
  "type": "object", "additionalProperties": false,
  "required": ["timestamp", "open", "volume"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "open": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" },
    "volume": { "type": "integer", "minimum": 0 }
  }
}
