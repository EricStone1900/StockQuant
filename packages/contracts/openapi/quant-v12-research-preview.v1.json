{
  "openapi": "3.1.0",
  "info": { "title": "StockQuant V1.2 Quant Research Read API", "version": "1.0.0" },
  "servers": [{ "url": "http://quant-research-service:3003" }],
  "components": { "securitySchemes": { "ServiceBearer": { "type": "http", "scheme": "bearer" } } },
  "paths": {
    "/v1/qlib/probe": { "get": { "operationId": "getV12QlibProbe", "summary": "Read local Qlib adapter readiness without fitting a model", "security": [{ "ServiceBearer": [] }], "parameters": [{ "name": "x-stockquant-service-id", "in": "header", "required": true, "schema": { "const": "platform-api-service" } }], "responses": { "200": { "description": "Qlib adapter probe", "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/research/v12-qlib-probe-preview.schema.json" } } } }, "401": { "description": "Platform service bearer required" } } } },
    "/v1/rdagent/probe": { "get": { "operationId": "getV12RDagentProbe", "summary": "Read fixed isolated RD-Agent boundary probe without model calls", "security": [{ "ServiceBearer": [] }], "parameters": [{ "name": "x-stockquant-service-id", "in": "header", "required": true, "schema": { "const": "platform-api-service" } }], "responses": { "200": { "description": "RD-Agent boundary probe", "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/research/v12-rdagent-probe-preview.schema.json" } } } }, "401": { "description": "Platform service bearer required" } } } },
    "/v1/factors/preview": { "get": { "operationId": "getV12FactorPreview", "summary": "Read V1.2 strategy output only when it is computed from its versioned data and Qlib path", "security": [{ "ServiceBearer": [] }], "parameters": [{ "name": "x-stockquant-service-id", "in": "header", "required": true, "schema": { "const": "platform-api-service" } }], "responses": { "200": { "description": "Computed factor result or explicit NOT_RUN state", "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/research/v12-factor-preview.schema.json" } } } }, "401": { "description": "Platform service bearer required" } } } }
  }
}
