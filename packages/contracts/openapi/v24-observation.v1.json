{
  "openapi": "3.1.0",
  "info": { "title": "StockQuant V2.4 Observation API", "version": "v1" },
  "servers": [{ "url": "http://platform-api-service:3000" }],
  "security": [{ "localSession": [] }],
  "paths": {
    "/api/v1/acceptance/v2/v2.4/paper-readiness": {
      "get": {
        "operationId": "readV24PaperExecutionReadiness",
        "summary": "Read fail-closed Paper readiness through the Platform API and Trade Execution",
        "security": [{ "localSession": [] }],
        "parameters": [{ "name": "market", "in": "query", "required": true, "schema": { "enum": ["CN_A", "US_EQUITY"] } }],
        "responses": {
          "200": { "description": "Policy and Mandate readiness; no risk, reservation, or order side effects", "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/common/v24-paper-readiness.schema.json" } } } },
          "401": { "description": "A local session is required" },
          "403": { "description": "The authenticated user is outside the local acceptance scope" },
          "422": { "description": "Unsupported market" },
          "503": { "description": "Trade Execution readiness is unavailable" }
        }
      }
    },
    "/api/v1/acceptance/v2/v2.4/runs": {
      "post": {
        "operationId": "createV24PaperStageRun",
        "summary": "Create an owner-scoped V2.4 readiness TestRun",
        "security": [{ "localSession": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/common/v24-paper-stage-run-request.schema.json" } } } },
        "responses": {
          "202": { "description": "Persisted WAITING readiness run", "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/common/v24-paper-stage-run-accepted.schema.json" } } } },
          "400": { "description": "Malformed JSON request" },
          "401": { "description": "A local session is required" },
          "403": { "description": "The scenario is unsupported or the user is outside the local acceptance scope" }
        }
      }
    },
    "/api/v1/acceptance/v2/v2.4/runs/{testRunId}": {
      "get": {
        "operationId": "readOwnedV24PaperStageRun",
        "summary": "Read an owner-scoped V2.4 readiness TestRun",
        "security": [{ "localSession": [] }],
        "parameters": [
          { "name": "testRunId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "x-stockquant-user", "in": "header", "required": false, "description": "Available only when the local test identity header is enabled.", "schema": { "type": "string", "minLength": 1 } }
        ],
        "responses": {
          "200": { "description": "The exact persisted WAITING run", "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/common/v24-paper-stage-run-result.schema.json" } } } },
          "401": { "description": "A local session is required" },
          "403": { "description": "The authenticated user is outside the local acceptance scope" },
          "404": { "description": "The run is missing, unowned, or not a V2.4 run" }
        }
      }
    },
    "/api/v1/acceptance/v2/v2.4/runs/{testRunId}/recover": {
      "post": {
        "operationId": "recoverOwnedV24PaperRecoveryRun",
        "summary": "Recover a failed owner-scoped V2.4 recovery TestRun after querying its original FakeBroker client order identity",
        "security": [{ "localSession": [] }],
        "parameters": [{ "name": "testRunId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "202": { "description": "Recovered, still UNKNOWN, or waiting on the original order/outbox", "content": { "application/json": { "schema": { "type": "object", "required": ["accepted", "testRunId", "status", "executionResent"], "properties": { "accepted": { "const": true }, "testRunId": { "type": "string", "format": "uuid" }, "status": { "enum": ["COMPLETED", "FAILED", "UNKNOWN"] }, "executionResent": { "type": "boolean" }, "recoveredOrderId": { "type": "string", "format": "uuid" }, "resourceReservation": { "type": "string" } } } } } },
          "401": { "description": "A local session is required" },
          "403": { "description": "The authenticated user is outside the local acceptance scope" },
          "404": { "description": "The run is missing or outside the owner scope" },
          "409": { "description": "The run is not a failed V2.4 recovery TestRun or lacks its persisted original command" },
          "503": { "description": "A domain service is unavailable before recovery can be safely recorded" }
        }
      }
    },
    "/api/v1/acceptance/v2/v2.4/runs/{testRunId}/history": {
      "get": {
        "operationId": "listOwnedV24PaperRecoveryHistory",
        "summary": "List immutable prior status and evidence revisions for an owned V2.4 recovery TestRun",
        "security": [{ "localSession": [] }],
        "parameters": [{ "name": "testRunId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Prior run evidence revisions, oldest first", "content": { "application/json": { "schema": { "type": "object", "required": ["testRunId", "revisions"], "properties": { "testRunId": { "type": "string", "format": "uuid" }, "revisions": { "type": "array", "items": { "type": "object", "required": ["revisionId", "status", "assertions", "evidence", "recordedAt"], "properties": { "revisionId": { "type": "integer" }, "status": { "type": "string" }, "assertions": { "type": "array" }, "evidence": { "type": "object" }, "recordedAt": { "type": "string", "format": "date-time" } } } } } } } } },
          "401": { "description": "A local session is required" },
          "403": { "description": "The authenticated user is outside the local acceptance scope" },
          "404": { "description": "The run is missing, unowned, or not a V2.4 recovery run" }
        }
      }
    },
    "/api/v1/acceptance/v2/v2.4/runs/{testRunId}/revisions": {
      "get": {
        "operationId": "listV24ObservationRunRevisions",
        "summary": "List prior evidence revisions for an owned V2.4 observation TestRun",
        "parameters": [
          { "name": "testRunId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "x-stockquant-user", "in": "header", "required": false, "description": "Available only when the local test identity header is enabled.", "schema": { "type": "string", "minLength": 1 } }
        ],
        "responses": {
          "200": { "description": "Owner-scoped prior evidence revisions", "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/common/v24-observation-run-revision-list.schema.json" } } } },
          "401": { "description": "A local session is required" },
          "403": { "description": "The authenticated user is outside the local acceptance scope" },
          "404": { "description": "The run is missing, unowned, or not a V2.4 observation run" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localSession": { "type": "apiKey", "in": "cookie", "name": "sq_session" }
    }
  }
}
