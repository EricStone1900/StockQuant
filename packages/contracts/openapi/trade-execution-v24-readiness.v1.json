{
  "openapi": "3.1.0",
  "info": { "title": "StockQuant Trade Execution V2.4 Readiness API", "version": "1.0.0" },
  "servers": [{ "url": "http://trade-execution-service:3005" }],
  "security": [{ "ServiceBearer": [] }],
  "paths": {
    "/internal/v1/v24/paper-readiness": {
      "get": {
        "operationId": "getV24PaperExecutionReadiness",
        "summary": "Read fail-closed V2.4 policy and Mandate readiness without evaluating risk or reserving resources",
        "security": [{ "ServiceBearer": [] }],
        "parameters": [
          { "name": "x-stockquant-service-id", "in": "header", "required": true, "schema": { "const": "platform-api-service" } },
          { "name": "market", "in": "query", "required": true, "schema": { "enum": ["CN_A", "US_EQUITY"] } }
        ],
        "responses": {
          "200": { "description": "Read-only readiness; order submission remains disabled", "content": { "application/json": { "schema": { "$ref": "https://stockquant.local/schemas/common/v24-paper-readiness.schema.json" } } } },
          "400": { "description": "Unsupported market or malformed query" },
          "403": { "description": "Service identity or route scope is not allowed" },
          "503": { "description": "Readiness policy or mandate contract is unavailable" }
        }
      }
    }
  },
  "components": { "securitySchemes": { "ServiceBearer": { "type": "http", "scheme": "bearer" } } }
}
