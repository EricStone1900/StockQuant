    "/v2/minute/imports/{version}/replay-readiness": {
      "get": {
        "operationId": "checkMarketDataMinuteImportReplayReadiness",
        "summary": "Resolve immutable historical context versions and validate replay scope",
        "security": [{ "ServiceBearer": [] }],
        "parameters": [
