          "401": {
            "description": "Service identity required"
          },
          "404": {
            "description": "Import not found"
          },
          "422": {
            "description": "Page request rejected"
          }
        }
      }
    },
    "/v2/minute/imports/{version}/daily-aggregate-check": {
      "post": {
        "operationId": "checkMarketDataMinuteDailyAggregate",
        "summary": "Compare imported RAW minute bars with an operator-supplied daily reference",
        "security": [{ "ServiceBearer": [] }],
        "parameters": [
          { "name": "x-stockquant-service-id", "in": "header", "required": true, "schema": { "type": "string", "const": "platform-api-service" } },
          { "name": "version", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["securityId", "tradingDate", "frequency", "reference", "referenceSource", "sourceReference"], "properties": {
            "securityId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "tradingDate": { "type": "string", "format": "date" },
            "frequency": { "type": "string", "enum": ["1m", "5m"] },
            "reference": { "type": "object", "required": ["open", "high", "low", "close", "volume", "amount"], "properties": { "open": { "type": "number", "minimum": 0 }, "high": { "type": "number", "minimum": 0 }, "low": { "type": "number", "minimum": 0 }, "close": { "type": "number", "minimum": 0 }, "volume": { "type": "number", "minimum": 0 }, "amount": { "type": "number", "minimum": 0 } } },
            "referenceSource": { "type": "string", "minLength": 1 },
            "sourceReference": { "type": "string", "minLength": 1 }
          } } } }
        },
        "responses": { "200": { "description": "Aggregate comparison with explicit operator-provided provenance and independent completeness status" }, "401": { "description": "Service identity required" }, "404": { "description": "Import not found" }, "422": { "description": "Request or import semantics rejected" } }
      }
    },
    "/v2/minute/coverage": {
      "post": {
        "operationId": "calculateMarketDataMinuteCoverage",
        "summary": "Calculate per-bar coverage and data quality for an imported range",
        "security": [{ "ServiceBearer": [] }],
        "parameters": [{
          "name": "x-stockquant-service-id",
          "in": "header",
          "required": true,
          "schema": { "type": "string", "const": "platform-api-service" }
        }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["securityIds", "fromDate", "toDate", "windowMinutes", "bars"],
                "properties": {
                  "securityIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
                  "fromDate": { "type": "string", "format": "date" },
                  "toDate": { "type": "string", "format": "date" },
                  "windowMinutes": { "type": "integer", "enum": [1, 5] },
                  "bars": { "type": "array", "items": { "type": "object" }, "maxItems": 5000 }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Coverage is complete" },
          "422": { "description": "Coverage is incomplete or input is invalid" }
        }
      }
    },
