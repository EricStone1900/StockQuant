{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/contracts/decision-governance/v24-c5-local-reservation-verification-v1.schema.json",
  "title": "V24C5LocalReservationVerificationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["reservationId", "mandateId", "mandateVersion", "ownerId", "accountId", "namespace", "testRunId", "clientOrderId", "commandHash", "proposalId", "proposalVersion", "proposalHash", "amount"],
  "properties": {
    "reservationId": { "type": "string", "format": "uuid" },
    "mandateId": { "type": "string", "format": "uuid" },
    "mandateVersion": { "type": "integer", "minimum": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "accountId": { "type": "string", "format": "uuid" },
    "namespace": { "type": "string", "minLength": 1 },
    "testRunId": { "type": "string", "format": "uuid" },
    "clientOrderId": { "type": "string", "minLength": 1 },
    "commandHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposalId": { "type": "string", "format": "uuid" },
    "proposalVersion": { "type": "integer", "minimum": 1 },
    "proposalHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" }
  }
}
