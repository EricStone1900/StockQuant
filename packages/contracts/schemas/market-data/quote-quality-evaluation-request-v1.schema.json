{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/contracts/market-data/quote-quality-evaluation-request-v1.schema.json",
  "title": "MarketMonitorQuoteQualityEvaluationRequest",
  "type": "object",
  "required": ["scope", "taskId", "expectedSecurityIds", "observations"],
  "properties": {
    "scope": { "$ref": "https://stockquant.local/contracts/market-data/quote-quality-scope-v1.schema.json" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "expectedSecurityIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "observations": { "type": "array", "maxItems": 100, "items": { "type": "object", "required": ["securityId", "snapshotId", "sourceId", "dataMode", "observedAt", "ingestedAt", "availableAt", "ageSeconds", "freshness", "status"], "properties": { "securityId": { "type": "string" }, "snapshotId": { "type": "string" }, "sourceId": { "type": "string" }, "dataMode": { "enum": ["FIXTURE", "REAL"] }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "ingestedAt": { "type": ["string", "null"], "format": "date-time" }, "availableAt": { "type": ["string", "null"], "format": "date-time" }, "ageSeconds": { "type": ["integer", "null"] }, "freshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] }, "status": { "enum": ["READY", "STALE", "UNKNOWN"] } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
