{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/contracts/live-quote-preview-v1.schema.json",
  "title": "LiveQuotePreview",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceId", "requestedSymbols", "securities", "count", "ingestedAt"],
  "properties": {
    "sourceId": {"const": "tencent-quote"},
    "requestedSymbols": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1}},
    "securities": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "price", "name", "observedAt", "ingestedAt", "status"], "properties": {"symbol": {"type": "string"}, "price": {"type": "number"}, "name": {"type": ["string", "null"]}, "observedAt": {"type": ["string", "null"], "format": "date-time"}, "ingestedAt": {"type": "string", "format": "date-time"}, "status": {"enum": ["LIVE_SOURCE", "MISSING_TIMESTAMP", "MALFORMED", "SOURCE_ERROR"]}}}},
    "count": {"type": "integer", "minimum": 0},
    "ingestedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "STALE"},
    "error": {"type": "string"}
  }
}
