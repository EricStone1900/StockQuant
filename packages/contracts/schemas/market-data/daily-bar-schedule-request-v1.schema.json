{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/market-data/daily-bar-schedule-request-v1.schema.json",
  "title": "Daily Bar Schedule Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "scope"],
  "properties": {
    "enabled": { "type": "boolean" },
    "scope": { "type": "object", "additionalProperties": false, "required": ["market", "ownerId", "accountId", "namespace", "testRunId"], "properties": { "market": { "const": "CN_A" }, "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 }, "accountId": { "type": "string", "format": "uuid" }, "namespace": { "type": "string", "minLength": 1, "maxLength": 128 }, "testRunId": { "type": "string", "format": "uuid" } } }
  }
}
