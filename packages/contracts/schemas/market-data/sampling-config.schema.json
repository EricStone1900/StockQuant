{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/contracts/market-data/sampling-config-v1.schema.json",
  "title": "MarketDataSamplingConfig",
  "type": "object",
  "required": [
    "intervalMinutes",
    "allowed",
    "tradingWindows",
    "lunchBreak",
    "placeOrders"
  ],
  "properties": {
    "intervalMinutes": {
      "enum": [
        20,
        30
      ]
    },
    "settingsVersion": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "persistence": {
      "enum": [
        "POSTGRESQL",
        "UNAVAILABLE"
      ]
    },
    "scheduleSeparation": {
      "type": "object",
      "properties": {
        "snapshotSampling": {
          "const": "CONFIGURED"
        },
        "monitorEvaluation": {
          "const": "CONFIGURED"
        },
        "orderExecution": {
          "const": "NOT_CONFIGURED"
        },
        "dailyBarCompletion": {
          "const": "NOT_CONFIGURED"
        },
        "strategyEvaluation": {
          "const": "NOT_CONFIGURED"
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["policyId", "version", "enabled", "trigger", "intervalMinutes", "timezone", "windows", "activationGate", "executor", "updatedAt"],
        "properties": {
          "policyId": { "enum": ["snapshotSampling", "monitorEvaluation", "dailyBarCompletion", "strategyEvaluation", "orderExecution"] },
          "version": { "type": "integer", "minimum": 0 },
          "enabled": { "type": "boolean" },
          "trigger": { "enum": ["FIXED_INTERVAL", "ON_QUOTE_AVAILABLE", "AFTER_SESSION_CLOSE", "ON_DAILY_BAR_READY", "C5_EXECUTION_WINDOW"] },
          "intervalMinutes": { "type": ["integer", "null"], "enum": [20, 30, null] },
          "timezone": { "const": "Asia/Shanghai" },
          "windows": { "type": "array", "items": { "type": "object", "required": ["name", "start", "end"], "properties": { "name": { "type": "string" }, "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }, "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } }, "additionalProperties": false } },
          "activationGate": { "enum": ["SOURCE_AUTHORIZATION", "DATA_READY", "OD007_APPROVAL", "C5_APPROVAL"] },
          "executor": { "enum": ["CONFIGURED", "NOT_IMPLEMENTED"] },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "allowed": {
      "type": "array",
      "items": {
        "enum": [
          20,
          30
        ]
      }
    },
    "tradingWindows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "start",
          "end"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      }
    },
    "lunchBreak": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "placeOrders": {
      "const": false
    }
  },
  "additionalProperties": true
}
