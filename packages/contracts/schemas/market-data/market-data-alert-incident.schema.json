{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/contracts/market-data/market-data-alert-incident-v1.schema.json",
  "title": "MarketDataAlertIncidentV1",
  "type": "object",
  "required": ["incidentId", "alertKey", "code", "severity", "payload", "state", "firstSeenAt", "lastSeenAt", "acknowledgedBy", "acknowledgedAt", "resolvedAt"],
  "properties": {
    "incidentId": { "type": "string", "format": "uuid" },
    "alertKey": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["INFO", "WARNING", "CRITICAL"] },
    "payload": { "type": "object" },
    "state": { "enum": ["OPEN", "ACKNOWLEDGED", "RESOLVED"] },
    "firstSeenAt": { "type": "string", "format": "date-time" },
    "lastSeenAt": { "type": "string", "format": "date-time" },
    "acknowledgedBy": { "type": ["string", "null"] },
    "acknowledgedAt": { "type": ["string", "null"], "format": "date-time" },
    "resolvedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
