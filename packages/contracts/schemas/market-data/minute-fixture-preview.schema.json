{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/contracts/market-data/minute-fixture-preview-v1.schema.json",
  "title": "MinuteFixturePreview",
  "type": "object",
  "required": [
    "fixtureVersion",
    "rows",
    "securities",
    "quality",
    "bars"
  ],
  "properties": {
    "fixtureVersion": {
      "type": "string"
    },
    "rows": {
      "type": "integer",
      "minimum": 0
    },
    "securities": {
      "type": "integer",
      "minimum": 0
    },
    "quality": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "row"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "row": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "bars": {
      "type": "array",
      "items": {
        "$ref": "https://stockquant.local/contracts/market-data/minute-bar.schema.json"
      }
    }
  },
  "additionalProperties": false
}
