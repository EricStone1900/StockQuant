{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/common/account-snapshot.schema.json",
  "title": "AccountSnapshot",
  "type": "object",
  "additionalProperties": false,
    "required": ["accountId", "namespace", "testRunId", "ownerId", "fixtureAccountRef", "market", "environmentMode", "brokerMode", "cash", "unsettledReceivables", "positionCount", "ledgerEntryCount", "ledgerVersion"],
  "properties": {
    "accountId": { "type": "string", "format": "uuid" },
    "namespace": { "type": "string", "minLength": 1 },
    "testRunId": { "type": "string", "format": "uuid" },
    "ownerId": { "type": "string", "minLength": 1 },
    "fixtureAccountRef": { "type": "string", "minLength": 1 },
    "market": { "enum": ["CN_A", "US_EQUITY"] },
    "environmentMode": { "enum": ["PAPER", "BACKTEST"] },
    "brokerMode": { "const": "FAKE" },
    "cash": { "$ref": "money.schema.json" },
    "unsettledReceivables": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["fillId", "amount", "currency", "tradeDate", "settlementDate", "calendarVersion", "settlementErrorCode", "status"], "properties": { "fillId": { "type": "string", "format": "uuid" }, "amount": { "type": "string" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "tradeDate": { "type": "string", "format": "date" }, "settlementDate": { "type": ["string", "null"], "format": "date" }, "calendarVersion": { "type": "string" }, "settlementErrorCode": { "enum": ["SETTLEMENT_CALENDAR_UNAVAILABLE", null] }, "status": { "enum": ["PENDING", "SETTLED"] } } } },
    "positionCount": { "type": "integer", "minimum": 0 },
    "ledgerEntryCount": { "type": "integer", "minimum": 0 },
    "ledgerVersion": { "type": "integer", "minimum": 1 },
    "positions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["security", "quantity"], "properties": { "security": { "type": "string", "pattern": "^[A-Z0-9.]{3,20}$" }, "quantity": { "type": "integer", "minimum": 1 } } } },
    "reservations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["reservationId", "clientOrderId", "side", "cashAmount", "capturedCashAmount", "capturedQuantity", "status", "evidenceRef"], "properties": { "reservationId": { "type": "string", "format": "uuid" }, "clientOrderId": { "type": "string", "minLength": 1 }, "side": { "enum": ["BUY", "SELL"] }, "cashAmount": { "type": ["string", "null"] }, "capturedCashAmount": { "type": "string" }, "capturedQuantity": { "type": "integer", "minimum": 0 }, "status": { "enum": ["HELD", "UNKNOWN", "CAPTURED", "RELEASED"] }, "evidenceRef": { "type": ["string", "null"] } } } }
  }
}
