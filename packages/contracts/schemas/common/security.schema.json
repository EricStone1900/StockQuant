{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/common/security.schema.json",
  "title": "Security",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "securityId",
    "market",
    "listingVenue",
    "instrumentType",
    "quoteCurrency",
    "tickerAliases"
  ],
  "properties": {
    "securityId": { "type": "string", "format": "uuid" },
    "market": { "enum": ["CN_A", "US_EQUITY"] },
    "listingVenue": { "type": "string", "minLength": 1 },
    "instrumentType": { "enum": ["COMMON_STOCK"] },
    "quoteCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "tickerAliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "effectiveFrom"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1 },
          "effectiveFrom": { "type": "string", "format": "date-time" },
          "effectiveTo": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
