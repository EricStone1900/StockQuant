{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/common/resource-reservation-command.schema.json",
  "title": "ResourceReservationCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["accountId", "namespace", "testRunId", "ownerId", "idempotencyKey", "clientOrderId", "side", "currency", "cashAmount", "security", "quantity"],
  "properties": {
    "accountId": { "type": "string", "format": "uuid" },
    "namespace": { "type": "string", "minLength": 1, "maxLength": 256 },
    "testRunId": { "type": "string", "format": "uuid" },
    "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "clientOrderId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "side": { "enum": ["BUY", "SELL"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "cashAmount": { "oneOf": [{ "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,15})(?:\\.[0-9]{1,4})?$" }, { "type": "null" }] },
    "security": { "oneOf": [{ "type": "string", "pattern": "^[A-Z0-9.]{3,20}$" }, { "type": "null" }] },
    "quantity": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
  },
  "oneOf": [
    { "properties": { "side": { "const": "BUY" }, "cashAmount": { "type": "string" }, "security": { "type": "null" }, "quantity": { "type": "null" } } },
    { "properties": { "side": { "const": "SELL" }, "cashAmount": { "type": "null" }, "security": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 } } }
  ]
}
