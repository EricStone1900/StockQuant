{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/contracts/paired-backup-manifest-v2.schema.json",
  "title": "PairedBackupManifest",
  "properties": {
    "format": {"enum": ["stockquant.paired-backup.v1", "stockquant.paired-backup.cluster.v2"]},
    "backupId": {"type": "string"},
    "createdAt": {"type": "string"},
    "retentionClass": {"enum": ["DAILY", "MONTH_END"]},
    "database": {"type": "string"},
    "databaseInventory": {"type": "object"},
    "artifactVolume": {"type": "string"},
    "restoreValidation": {"type": "object"},
    "files": {"type": "array"}
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "backupId", "createdAt", "retentionClass", "database", "artifactVolume", "restoreValidation", "files"],
      "properties": {
        "format": {"const": "stockquant.paired-backup.v1"},
        "backupId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "createdAt": {"type": "string", "format": "date-time"},
        "retentionClass": {"enum": ["DAILY", "MONTH_END"]},
        "database": {"type": "string", "minLength": 1},
        "artifactVolume": {"type": "string", "minLength": 1},
        "restoreValidation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "checkedAt", "publishedArtifactRefs", "method"],
          "properties": {
            "status": {"const": "PASS"},
            "checkedAt": {"type": "string", "format": "date-time"},
            "publishedArtifactRefs": {"type": "integer", "minimum": 0},
            "method": {"const": "PG_RESTORE_AND_ARTIFACT_SHA256"}
          }
        },
        "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "backupId", "createdAt", "retentionClass", "databaseInventory", "artifactVolume", "restoreValidation", "files"],
      "properties": {
        "format": {"const": "stockquant.paired-backup.cluster.v2"},
        "backupId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "createdAt": {"type": "string", "format": "date-time"},
        "retentionClass": {"enum": ["DAILY", "MONTH_END"]},
        "databaseInventory": {
          "type": "object", "additionalProperties": false,
          "required": ["databases", "roles"],
          "properties": {
            "databases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 63}},
            "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "superuser", "inherit", "createRole", "createDb", "login", "replication", "bypassRls", "connlimit", "validUntil"], "properties": {"name": {"type": "string", "minLength": 1}, "superuser": {"type": "boolean"}, "inherit": {"type": "boolean"}, "createRole": {"type": "boolean"}, "createDb": {"type": "boolean"}, "login": {"type": "boolean"}, "replication": {"type": "boolean"}, "bypassRls": {"type": "boolean"}, "connlimit": {"type": "integer"}, "validUntil": {"type": ["string", "null"]}}}}
          }
        },
        "artifactVolume": {"type": "string", "minLength": 1},
        "restoreValidation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "checkedAt", "publishedArtifactRefs", "restoredDatabases", "restoredRoles", "method"],
          "properties": {
            "status": {"const": "PASS"},
            "checkedAt": {"type": "string", "format": "date-time"},
            "publishedArtifactRefs": {"type": "integer", "minimum": 0},
            "restoredDatabases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 63}},
            "restoredRoles": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "superuser", "inherit", "createRole", "createDb", "login", "replication", "bypassRls", "connlimit", "validUntil"], "properties": {"name": {"type": "string", "minLength": 1}, "superuser": {"type": "boolean"}, "inherit": {"type": "boolean"}, "createRole": {"type": "boolean"}, "createDb": {"type": "boolean"}, "login": {"type": "boolean"}, "replication": {"type": "boolean"}, "bypassRls": {"type": "boolean"}, "connlimit": {"type": "integer"}, "validUntil": {"type": ["string", "null"]}}}},
            "method": {"const": "ISOLATED_CLUSTER_RESTORE_AND_ARTIFACT_SHA256"}
          }
        },
        "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      }
    }
  ]
}
