{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/common/v24-paper-execution-scenario.schema.json",
  "title": "V24PaperExecutionScenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarioId", "scenarioVersion", "dataMode", "environmentMode", "brokerMode", "liveTradingEnabled", "market", "currency", "account", "policy", "mandate", "signal", "order", "snapshot", "risk", "fee"],
  "properties": {
    "$schema": { "type": "string" },
    "scenarioId": { "const": "v24-isolated-snapshot-paper-normal" },
    "scenarioVersion": { "const": "2.0.0" },
    "dataMode": { "const": "FIXTURE" },
    "environmentMode": { "const": "PAPER" },
    "brokerMode": { "const": "FAKE" },
    "liveTradingEnabled": { "const": false },
    "market": { "const": "CN_A" },
    "currency": { "const": "CNY" },
    "account": {
      "type": "object", "additionalProperties": false,
      "required": ["fixtureAccountRef", "initialCash"],
      "properties": {
        "fixtureAccountRef": { "type": "string", "minLength": 1 },
        "initialCash": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyId", "policyVersion", "riskPolicyVersion", "feePolicyVersion", "maxDeviationBps", "freshnessLimitSeconds", "executionWindowStart", "executionWindowEnd"],
      "properties": {
        "policyId": { "const": "v24-isolated-fixture-paper-policy" },
        "policyVersion": { "const": "2.0.0" },
        "riskPolicyVersion": { "const": "fixture-risk-v1" },
        "feePolicyVersion": { "const": "fixture-fee-v1" },
        "maxDeviationBps": { "type": "number", "minimum": 0, "maximum": 1000 },
        "freshnessLimitSeconds": { "type": "integer", "minimum": 0, "maximum": 1800 },
        "executionWindowStart": { "type": "string", "format": "date-time" },
        "executionWindowEnd": { "type": "string", "format": "date-time" }
      }
    },
    "mandate": {
      "type": "object", "additionalProperties": false,
      "required": ["mandateId", "mandateVersion", "strategyVersion", "securityScope", "maxOrderNotional", "maxGrossExposure", "maxDailyTurnover", "approvalEvidenceRef"],
      "properties": {
        "mandateId": { "const": "v24-isolated-fixture-paper-mandate" },
        "mandateVersion": { "const": "2.0.0" },
        "strategyVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "securityScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "maxOrderNotional": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" },
        "maxGrossExposure": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" },
        "maxDailyTurnover": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" },
        "approvalEvidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["signalId", "asOf", "action", "quantity", "referencePrice"],
      "properties": {
        "signalId": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "action": { "const": "BUY" },
        "quantity": { "type": "integer", "minimum": 1 },
        "referencePrice": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" }
      }
    },
    "order": {
      "type": "object", "additionalProperties": false,
      "required": ["security", "acceptedAt", "requestedQuantity", "clientOrderIdPrefix"],
      "properties": {
        "security": { "type": "string", "minLength": 1 },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "requestedQuantity": { "type": "integer", "minimum": 1 },
        "clientOrderIdPrefix": { "type": "string", "minLength": 1 }
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotId", "security", "market", "sourceMode", "status", "observedAt", "ingestedAt", "price"],
      "properties": {
        "snapshotId": { "type": "string", "minLength": 1 },
        "security": { "type": "string", "minLength": 1 },
        "market": { "const": "CN_A" },
        "sourceMode": { "const": "FIXTURE" },
        "status": { "const": "READY" },
        "observedAt": { "type": "string", "format": "date-time" },
        "ingestedAt": { "type": "string", "format": "date-time" },
        "price": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" }
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["supportedMarkets"],
      "properties": { "supportedMarkets": { "const": ["CN_A"] } }
    },
    "fee": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" }
  }
}
