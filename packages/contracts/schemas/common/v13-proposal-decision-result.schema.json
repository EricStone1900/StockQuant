    { "type": "object", "additionalProperties": false, "required": ["status", "proposalId", "proposalVersion", "contentHash", "decidedBy", "reason"], "properties": { "status": { "const": "REJECTED_MANUAL" }, "proposalId": { "type": "string", "format": "uuid" }, "proposalVersion": { "type": "integer" }, "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "decidedBy": { "type": "string" }, "reason": { "type": "string" } } }
  ]
