{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/common/v3.3-normal-verify-result.schema.json",
  "title": "V33NormalVerifyResult",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "testRunId", "status", "idempotent", "assertion", "evidence"],
  "properties": {
    "schemaVersion": { "const": "v3.3-normal-verify-result-v1" },
    "testRunId": { "type": "string", "format": "uuid" },
    "status": { "enum": ["RUNNING", "COMPLETED", "FAILED", "CANCELLED"] },
    "idempotent": { "type": "boolean" },
    "assertion": { "type": "object", "required": ["id", "status"], "properties": { "id": { "const": "V3.3_NORMAL_RESULTS_001" }, "status": { "enum": ["PASS", "FAIL"] } } },
    "evidence": { "type": "object" }
  }
}
