{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/common/fill-fee-correction-command.schema.json",
  "title": "FillFeeCorrectionCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "previousFee", "correctedFee", "effectiveAt", "evidenceRef"],
  "properties": {
    "revision": { "type": "integer", "minimum": 1 },
    "previousFee": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" },
    "correctedFee": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "evidenceRef": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
