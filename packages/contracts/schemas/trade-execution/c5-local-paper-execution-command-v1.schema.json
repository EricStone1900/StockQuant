{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/trade-execution/c5-local-paper-execution-command-v1.schema.json",
  "title": "C5 local FakeBroker execution command",
  "type": "object",
  "required": ["authorization"],
  "properties": {
    "authorization": {
      "type": "object",
      "required": ["mandateId", "mandateVersion", "ownerId", "accountId", "namespace", "testRunId", "targetId", "clientOrderId", "evaluatedAt", "commandHash", "reservationId", "proposal", "priceEvidence"],
      "properties": {
        "mandateId": { "type": "string", "format": "uuid" },
        "mandateVersion": { "type": "integer", "minimum": 1 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "accountId": { "type": "string", "format": "uuid" },
        "namespace": { "type": "string", "pattern": "^v24-paper-v2-" },
        "testRunId": { "type": "string", "format": "uuid" },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientOrderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "commandHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reservationId": { "type": "string", "format": "uuid" },
        "proposal": {
          "type": "object",
          "required": ["proposalId", "proposalVersion", "contentHash", "ownerId", "testRunId", "accountId", "strategyVersion", "operation", "market", "currency", "legs"],
          "properties": {
            "proposalId": { "type": "string", "format": "uuid" },
            "proposalVersion": { "type": "integer", "minimum": 1 },
            "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "ownerId": { "type": "string", "minLength": 1 },
            "testRunId": { "type": "string", "format": "uuid" },
            "accountId": { "type": "string", "format": "uuid" },
            "strategyVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "operation": { "const": "REBALANCE" },
            "market": { "const": "CN_A" },
            "currency": { "const": "CNY" },
            "legs": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "object", "required": ["securityId", "side", "quantity", "limitPrice", "estimatedFee"], "properties": { "securityId": { "const": "600000.SH" }, "side": { "enum": ["BUY", "SELL"] }, "quantity": { "const": 100 }, "limitPrice": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" }, "estimatedFee": { "const": "5.00" } }, "additionalProperties": false } }
          },
          "additionalProperties": false
        },
        "priceEvidence": {
          "type": "object",
          "required": ["targetId", "clientOrderId", "snapshotId", "side", "quantity", "price", "fee", "budgetAmount", "quoteAgeSeconds", "deviationBps", "observedAt"],
          "properties": {
            "targetId": { "type": "string", "minLength": 1 },
            "clientOrderId": { "type": "string", "minLength": 1 },
            "snapshotId": { "type": "string", "minLength": 1 },
            "side": { "enum": ["BUY", "SELL"] },
            "quantity": { "const": 100 },
            "price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
            "fee": { "const": "5.00" },
            "budgetAmount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
            "quoteAgeSeconds": { "type": "integer", "minimum": 0, "maximum": 60 },
            "deviationBps": { "type": "integer", "minimum": 0, "maximum": 100 },
            "observedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
