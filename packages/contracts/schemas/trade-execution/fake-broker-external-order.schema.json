{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/trade-execution/fake-broker-external-order.schema.json",
  "title": "FakeBrokerSimulatedExternalOrder",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "externalOrderId", "security", "requestedQuantity", "status", "evidenceRef", "observedAt"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1, "maxLength": 128 },
    "externalOrderId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "clientOrderId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "security": { "type": "string", "minLength": 1, "maxLength": 64 },
    "requestedQuantity": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["NEW", "PARTIALLY_FILLED", "FILLED", "CANCELLED", "REJECTED", "UNKNOWN"] },
    "evidenceRef": { "type": "string", "minLength": 1, "maxLength": 512 },
    "observedAt": { "type": "string", "format": "date-time" }
  }
}
