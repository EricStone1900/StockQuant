{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/qlib-summary-train-request.schema.json",
  "title": "QlibSummaryTrainRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["bars"],
  "properties": {
    "bars": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["open"], "properties": { "timestamp": { "type": "string", "format": "date-time" }, "open": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$" }, "volume": { "type": "integer", "minimum": 0 } }, "additionalProperties": true } }
  }
}
