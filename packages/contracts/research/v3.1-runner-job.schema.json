{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.1-runner-job.schema.json",
  "title": "V3.1RunnerJob",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "testRunId", "experimentId", "imageDigest", "inputArtifact", "outputNamespace", "resources", "networkPolicy"],
  "properties": {
    "schemaVersion": { "const": "v3.1-runner-job-v1" },
    "testRunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "experimentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputArtifact": { "type": "string", "pattern": "^research/[^/]+/[^/]+/inputs/[a-f0-9]{64}$" },
    "outputNamespace": { "type": "string", "pattern": "^research/[^/]+/[^/]+/outputs$" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuMilli", "memoryMiB", "timeoutSeconds", "pidsLimit"],
      "properties": {
        "cpuMilli": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "memoryMiB": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "pidsLimit": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowlist"],
      "properties": {
        "mode": { "enum": ["DENY", "ALLOWLIST"] },
        "allowlist": { "type": "array", "items": { "type": "string", "pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$" } }
      }
    }
  }
}
