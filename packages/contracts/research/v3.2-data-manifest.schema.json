{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.2-data-manifest.schema.json",
  "title": "V32PromotionDataManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "testRunId", "experimentId", "dataMode", "dataVersion", "dataContentSha256"],
  "properties": {
    "schemaVersion": { "const": "v3.2-data-manifest-v1" },
    "testRunId": { "type": "string", "format": "uuid" },
    "experimentId": { "type": "string", "format": "uuid" },
    "dataMode": { "enum": ["FIXTURE", "RECORDED", "REAL"] },
    "dataVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dataContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
