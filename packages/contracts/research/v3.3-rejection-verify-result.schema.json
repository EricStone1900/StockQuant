{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.3-rejection-verify-result.schema.json",
  "title": "V33RejectionVerifyResult",
  "type": "object",
  "additionalProperties": false,
