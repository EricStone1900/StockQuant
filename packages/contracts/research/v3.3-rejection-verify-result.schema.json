  "properties": {
    "schemaVersion": { "const": "v3.3-rejection-verify-result-v1" },
    "testRunId": { "type": "string", "format": "uuid" },
    "status": { "const": "RUNNING" },
    "idempotent": { "type": "boolean" },
    "assertion": { "type": "object" },
    "evidence": { "type": "object" }
  }
}
