{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.3-experiment-ledger-settlement-result.schema.json",
  "title": "V33ExperimentLedgerSettlementResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["experimentId", "testRunId", "requestedCents", "reservedCents", "spentCents", "status", "modelCallCount", "rounds"],
  "properties": {
    "experimentId": { "type": "string", "format": "uuid" },
    "testRunId": { "type": "string", "format": "uuid" },
    "requestedCents": { "type": "integer", "minimum": 1 },
    "reservedCents": { "type": "integer", "minimum": 1 },
    "spentCents": { "type": "integer", "minimum": 0 },
    "status": { "const": "SETTLED" },
    "modelCallCount": { "type": "integer", "minimum": 1, "maximum": 3 },
    "rounds": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["roundIndex", "settledCents"], "properties": { "roundIndex": { "type": "integer", "minimum": 1, "maximum": 3 }, "settledCents": { "type": "integer", "minimum": 0 } } } }
  }
}
