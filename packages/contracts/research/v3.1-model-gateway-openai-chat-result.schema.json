{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.1-model-gateway-openai-chat-result.schema.json",
  "title": "V31ModelGatewayOpenAIChatResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "object", "created", "model", "choices", "usage"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "object": { "const": "chat.completion" },
    "created": { "type": "integer", "minimum": 0 },
    "model": { "const": "stockquant-fixture" },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "message", "finish_reason"],
        "properties": {
          "index": { "const": 0 },
          "message": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": { "role": { "const": "assistant" }, "content": { "type": "string" } }
          },
          "finish_reason": { "const": "stop" }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
