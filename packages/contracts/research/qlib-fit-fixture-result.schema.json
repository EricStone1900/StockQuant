{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/qlib-fit-fixture-result.schema.json",
  "title": "QlibFitFixtureResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "sourceMode", "modelTraining", "modelValidation", "candidateSourceExecution", "qlibVersion", "lightgbmVersion", "model", "segments", "testPredictionCount", "testPredictionsFinite", "testPredictionsSha256", "modelSha256", "modelArtifactBase64", "testPredictionsCanonicalJson", "testPredictions", "evaluationMetrics", "tracking", "profitabilityClaim"],
  "properties": {
    "schemaVersion": { "const": "qlib-fit-fixture-result-v1" },
    "status": { "const": "COMPLETED" },
    "sourceMode": { "const": "FIXTURE" },
    "modelTraining": { "const": "PASS" },
    "modelValidation": { "const": "NOT_RUN" },
    "temporalValidation": { "enum": ["PASS", "NOT_RUN"] },
    "candidateSourceExecution": { "const": "NOT_PERFORMED" },
    "qlibVersion": { "type": "string", "minLength": 1 },
    "lightgbmVersion": { "type": "string", "minLength": 1 },
    "model": { "const": "qlib.contrib.model.gbdt.LGBModel" },
    "segments": {
      "type": "object", "additionalProperties": false, "required": ["train", "valid", "test"],
      "properties": {
        "train": { "type": "object", "additionalProperties": false, "required": ["start", "end", "rows"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 } } },
        "valid": { "type": "object", "additionalProperties": false, "required": ["start", "end", "rows"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 } } },
        "test": { "type": "object", "additionalProperties": false, "required": ["start", "end", "rows"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 } } }
      }
    },
    "testPredictionCount": { "type": "integer", "minimum": 5 },
    "testPredictionsFinite": { "const": true },
    "testPredictionsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelArtifactBase64": { "type": "string", "contentEncoding": "base64", "maxLength": 900000 },
    "testPredictionsCanonicalJson": { "type": "string", "maxLength": 200000 },
    "testPredictions": { "type": "array", "minItems": 5, "maxItems": 10000, "items": { "type": "number" } },
    "evaluationMetrics": { "type": "object" },
    "tracking": { "const": "temporary SQLite under /tmp; removed with the worker container" },
    "profitabilityClaim": { "const": "NOT_MADE" }
  }
}
