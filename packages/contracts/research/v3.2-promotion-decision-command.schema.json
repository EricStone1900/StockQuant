{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.2-promotion-decision-command.schema.json",
  "title": "V3.2PromotionDecisionCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "confirmation", "reportFingerprint", "actorId"],
  "properties": {
    "schemaVersion": { "const": "v3.2-promotion-decision-command-v1" },
    "decision": { "enum": ["APPROVE", "REJECT"] },
    "confirmation": { "const": "REVIEW_EXACT_PROMOTION_VERSION" },
    "reportFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actorId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" }
  }
}
