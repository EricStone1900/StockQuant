{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.2-candidate-mandate-binding-command.schema.json",
  "title": "V32CandidateMandateBindingCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mandateId", "testRunId", "ownerId", "accountId", "market", "environmentMode", "brokerMode", "strategyVersion", "candidateArtifact"],
  "properties": {
    "schemaVersion": { "const": "v3.2-candidate-mandate-binding-command-v1" },
    "mandateId": { "type": "string", "format": "uuid" },
    "testRunId": { "type": "string", "format": "uuid" },
    "ownerId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "accountId": { "type": "string", "format": "uuid" },
    "market": { "const": "CN_A" },
    "environmentMode": { "const": "PAPER" },
    "brokerMode": { "const": "FAKE" },
    "strategyVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateArtifact": { "type": "object", "additionalProperties": false, "required": ["artifactId", "namespace", "sha256"], "properties": { "artifactId": { "type": "string", "minLength": 1 }, "namespace": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  }
}
