{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v14-daily-backtest-request.schema.json",
  "title": "V1.4 Daily Backtest Fixture Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarioId", "seed", "policy"],
  "properties": {
    "scenarioId": { "type": "string", "enum": ["normal", "rejection", "recovery", "market-restrictions", "historical-fees"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "policy": { "type": "object", "additionalProperties": false, "required": ["initialCashCents", "targetQuantity", "participationRateBasisPoints", "slippageBasisPoints", "fixedFeeCents"], "properties": {
      "initialCashCents": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
      "targetQuantity": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
      "participationRateBasisPoints": { "type": "integer", "minimum": 1, "maximum": 10000 },
      "slippageBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
      "fixedFeeCents": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "marketFeeSchedule": { "type": "object", "additionalProperties": false, "required": ["scheduleId", "commissionRatePartsPerBillion", "minimumCommissionCents"], "properties": {
        "scheduleId": { "enum": ["CN_A_CASH_EQUITY_2022_04_29_TO_2023_08_27", "CN_A_CASH_EQUITY_2023_08_28"] },
        "commissionRatePartsPerBillion": { "type": "integer", "minimum": 54100, "maximum": 3000000 },
        "minimumCommissionCents": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }, "allOf": [{ "if": { "properties": { "scheduleId": { "const": "CN_A_CASH_EQUITY_2022_04_29_TO_2023_08_27" } }, "required": ["scheduleId"] }, "then": { "properties": { "commissionRatePartsPerBillion": { "minimum": 68700 } } } }] },
      "sellOrder": { "type": "object", "additionalProperties": false, "required": ["signalDate", "executionDate", "quantity"], "properties": {
        "signalDate": { "type": "string", "format": "date" },
        "executionDate": { "type": "string", "format": "date" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      } }
    } }
  }
}
