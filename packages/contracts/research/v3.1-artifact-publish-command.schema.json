{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://stockquant.local/schemas/research/v3.1-artifact-publish-command.schema.json", "title": "V31ArtifactPublishCommand",
  "type": "object", "additionalProperties": false, "required": ["ref", "contentBase64"],
  "properties": {
    "ref": { "$ref": "v3.1-artifact-ref.schema.json" },
    "contentBase64": { "type": "string", "maxLength": 11184812, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 300 }, "workerId": { "type": "string", "maxLength": 128 }, "fencingToken": { "type": "integer", "minimum": 1 }
  }
}
