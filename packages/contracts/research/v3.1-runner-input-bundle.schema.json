{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.1-runner-input-bundle.schema.json",
  "title": "V3.1RunnerInputBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "script", "files"],
  "properties": {
    "schemaVersion": { "const": "v3.1-runner-input-bundle-v1" },
    "script": { "type": "string", "pattern": "^code/(?:[A-Za-z0-9][A-Za-z0-9._-]{0,127}/)*[A-Za-z0-9][A-Za-z0-9._-]{0,123}\\.py$", "maxLength": 512 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contentBase64"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?:code|data)/(?:[A-Za-z0-9][A-Za-z0-9._-]{0,127}/)*[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "maxLength": 512 },
          "contentBase64": { "type": "string", "maxLength": 11184812, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
        }
      }
    }
  }
}
