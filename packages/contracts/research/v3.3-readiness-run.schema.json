{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.3-readiness-run.schema.json",
  "title": "V33ReadinessRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["testRunId", "stageId", "scenarioId", "scenarioVersion", "status", "seed", "assertions", "evidence"],
  "properties": {
    "accepted": { "type": "boolean" },
    "testRunId": { "type": "string", "format": "uuid" },
    "stageId": { "const": "V3.3" },
    "scenarioId": { "enum": ["normal", "rejection", "recovery"] },
    "scenarioVersion": { "const": "v3.3-readiness-v1" },
    "status": { "const": "WAITING" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "assertions": { "type": "array", "items": { "type": "object", "additionalProperties": true, "required": ["id", "status"], "properties": { "id": { "type": "string" }, "status": { "const": "NOT_RUN" }, "reason": { "type": "string" } } } },
    "evidence": { "type": "object", "additionalProperties": true, "required": ["readiness", "blockers", "runnerDispatch", "runnerJobsCreated", "externalModelCalls", "paperContinuity"], "properties": {
      "readiness": { "const": "WAITING" },
      "blockers": { "type": "array", "items": { "type": "object", "additionalProperties": true, "required": ["id", "status", "reason"], "properties": { "id": { "type": "string" }, "status": { "enum": ["VERIFIED", "NOT_VERIFIED", "NOT_PROVIDED", "NOT_IMPLEMENTED"] }, "reason": { "type": "string" } } } },
      "runnerDispatch": { "const": "NOT_PERFORMED" },
      "runnerJobsCreated": { "const": 0 },
      "externalModelCalls": { "const": 0 },
      "paperContinuity": { "const": "NOT_CHECKED" }
    } },
    "createdAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
