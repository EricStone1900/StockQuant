{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.1-model-gateway-openai-embedding-result.schema.json",
  "title": "V31ModelGatewayOpenAIEmbeddingResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["object", "model", "data", "usage"],
  "properties": {
    "object": { "const": "list" },
    "model": { "const": "stockquant-fixture" },
    "data": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["object", "index", "embedding"], "properties": { "object": { "const": "embedding" }, "index": { "type": "integer", "minimum": 0 }, "embedding": { "oneOf": [{ "const": [0.125, -0.25, 0.5] }, { "type": "string", "contentEncoding": "base64", "minLength": 16, "maxLength": 32 }] } } } },
    "usage": { "type": "object", "additionalProperties": false, "required": ["prompt_tokens", "total_tokens"], "properties": { "prompt_tokens": { "type": "integer", "minimum": 0 }, "total_tokens": { "type": "integer", "minimum": 0 } } }
  }
}
