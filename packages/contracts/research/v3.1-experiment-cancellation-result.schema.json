{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://stockquant.local/schemas/research/v3.1-experiment-cancellation-result.schema.json", "title": "V31ExperimentCancellationResult",
  "type": "object", "additionalProperties": false,
  "required": ["experimentId", "fixtureId", "modelProfile", "rounds", "budgetCurrency", "budgetCents", "environmentMode", "brokerMode", "idempotencyKey", "status", "reason", "createdAt", "cancelledAt"],
  "properties": {
    "testRunId": { "type": "string", "format": "uuid" }, "experimentId": { "type": "string", "format": "uuid" },
    "fixtureId": { "type": "string", "minLength": 1 }, "modelProfile": { "type": "string", "minLength": 1 }, "rounds": { "type": "integer", "minimum": 1, "maximum": 3 },
    "budgetCurrency": { "const": "USD" }, "budgetCents": { "type": "integer", "minimum": 1, "maximum": 1000 }, "environmentMode": { "const": "RESEARCH" }, "brokerMode": { "const": "FAKE" },
    "idempotencyKey": { "type": "string", "minLength": 8 }, "status": { "const": "CANCELLED" }, "reason": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }, "cancelledAt": { "type": "string", "format": "date-time" }
  }
}
