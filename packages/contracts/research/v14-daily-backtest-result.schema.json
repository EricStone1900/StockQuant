{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v14-daily-backtest-result.schema.json",
  "title": "V1.4 Daily Backtest Fixture Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["testRunId", "stageId", "scenarioId", "seed", "status", "assertions", "evidence", "durableReport"],
  "properties": {
    "testRunId": { "type": "string", "format": "uuid" },
    "stageId": { "const": "V1.4" },
    "scenarioId": { "type": "string", "enum": ["normal", "rejection", "recovery", "market-restrictions", "historical-fees", "corporate-actions"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "status": { "type": "string", "enum": ["COMPLETED", "FAILED"] },
    "assertions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["assertionId", "status", "expected", "actual"], "properties": {
      "assertionId": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["PASS", "FAIL"] }, "expected": {}, "actual": {}
    } } },
    "evidence": { "type": "object", "required": ["executionModel"], "properties": {
      "executionModel": { "type": "object", "additionalProperties": false, "required": ["component", "modelId"], "properties": {
        "component": { "const": "QUANT_BACKTEST_ENGINE" },
        "modelId": { "type": "string", "enum": ["DAILY_BAR_CLOSE_NEXT_SESSION_PARTICIPATION_V1", "SYNTHETIC_DAILY_OHLC_RESTRICTION_RULES_V1", "RAW_DAILY_BAR_CORPORATE_ACTION_LEDGER_V1"] }
      } },
      "benchmark": { "type": "object", "additionalProperties": false, "required": ["benchmarkId", "initialClose", "finalClose", "returnBasisPoints", "excessReturnBasisPoints"], "properties": {
        "benchmarkId": { "type": "string", "minLength": 1 },
        "initialClose": { "type": "integer", "minimum": 1 },
        "finalClose": { "type": "integer", "minimum": 1 },
        "returnBasisPoints": { "type": "integer" },
        "excessReturnBasisPoints": { "type": "integer" }
      } },
      "orderOutcomes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["side", "signalDate", "executionDate", "requestedQuantity", "filledQuantity", "status"], "properties": {
        "side": { "type": "string", "enum": ["BUY", "SELL"] },
        "signalDate": { "type": "string", "format": "date" },
        "executionDate": { "type": "string", "format": "date" },
        "requestedQuantity": { "type": "integer", "minimum": 1 },
        "filledQuantity": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["FILLED", "PARTIALLY_FILLED", "REJECTED"] },
        "reason": { "type": "string", "enum": ["ZERO_VOLUME", "INSUFFICIENT_CASH", "PARTICIPATION_LIMIT", "T_PLUS_1_UNAVAILABLE", "NO_SELLABLE_POSITION"] }
      } } },
      "metrics": { "type": "object", "properties": {
        "rejectedOrders": { "type": "integer", "minimum": 0 },
        "partiallyFilledOrders": { "type": "integer", "minimum": 0 },
        "unfilledQuantity": { "type": "integer", "minimum": 0 }
      } }
    } },
    "durableReport": { "type": "object", "additionalProperties": false, "required": ["resultSha256", "manifestSha256"], "properties": {
      "resultSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    } }
  },
  "allOf": [
    { "if": { "properties": { "scenarioId": { "const": "market-restrictions" } }, "required": ["scenarioId"] }, "then": { "properties": { "evidence": { "properties": { "executionModel": { "properties": { "modelId": { "const": "SYNTHETIC_DAILY_OHLC_RESTRICTION_RULES_V1" } }, "required": ["modelId"] } } } } } },
    { "if": { "properties": { "scenarioId": { "const": "corporate-actions" } }, "required": ["scenarioId"] }, "then": { "properties": { "evidence": { "properties": { "executionModel": { "properties": { "modelId": { "const": "RAW_DAILY_BAR_CORPORATE_ACTION_LEDGER_V1" } }, "required": ["modelId"] } } } } } },
    { "if": { "properties": { "scenarioId": { "enum": ["normal", "rejection", "recovery", "historical-fees"] } }, "required": ["scenarioId"] }, "then": { "properties": { "evidence": { "properties": { "executionModel": { "properties": { "modelId": { "const": "DAILY_BAR_CLOSE_NEXT_SESSION_PARTICIPATION_V1" } }, "required": ["modelId"] } } } } } }
  ]
}
