{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.1-experiment-result.schema.json",
  "title": "V31ExperimentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["experimentId", "fixtureId", "modelProfile", "rounds", "budgetCurrency", "budgetCents", "environmentMode", "brokerMode", "idempotencyKey", "status", "reason", "createdAt", "cancelledAt", "budget"],
  "properties": {
    "testRunId": { "type": "string", "format": "uuid" },
    "experimentId": { "type": "string", "format": "uuid" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "modelProfile": { "type": "string", "minLength": 1 },
    "rounds": { "type": "integer", "minimum": 1, "maximum": 3 },
    "budgetCurrency": { "const": "USD" },
    "budgetCents": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "environmentMode": { "const": "RESEARCH" },
    "brokerMode": { "const": "FAKE" },
    "idempotencyKey": { "type": "string", "minLength": 8 },
    "status": { "enum": ["PENDING_PREREQUISITES", "CANCELLED"] },
    "reason": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "cancelledAt": { "type": ["string", "null"], "format": "date-time" },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["experimentId", "requestedCents", "reservedCents", "spentCents", "status"],
      "properties": {
        "experimentId": { "type": "string", "format": "uuid" },
        "requestedCents": { "type": "integer", "minimum": 1 },
        "reservedCents": { "type": "integer", "minimum": 0 },
        "spentCents": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["RESERVED", "SETTLED", "UNKNOWN", "REJECTED"] }
      }
    }
  }
}
