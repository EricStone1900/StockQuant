{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.1-model-gateway-openai-chat-command.schema.json",
  "title": "V31ModelGatewayOpenAIChatCommand",
  "type": "object",
  "additionalProperties": true,
  "required": ["model", "messages"],
  "properties": {
    "model": { "const": "stockquant-fixture" },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant", "tool"] },
          "content": { "oneOf": [{ "type": "string" }, { "type": "array" }] }
        }
      }
    },
    "stream": { "const": false }
  }
}
