{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.1-runner-complete-command.schema.json",
  "title": "V3.1RunnerCompleteCommand",
  "type": "object", "additionalProperties": false,
  "required": ["workerId", "fencingToken", "execution"],
  "properties": {
    "workerId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "fencingToken": { "type": "integer", "minimum": 1 },
    "execution": { "$ref": "v3.1-runner-execution.schema.json" },
    "artifacts": { "type": "array", "items": { "$ref": "v3.1-artifact-ref.schema.json" } }
  }
}
