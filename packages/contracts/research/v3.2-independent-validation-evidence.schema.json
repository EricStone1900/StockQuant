{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.2-independent-validation-evidence.schema.json",
  "title": "V32IndependentValidationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceSha256", "details"],
