{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/schemas/research/v3.1-experiment.schema.json",
  "title": "V3.1ExperimentRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtureId", "modelProfile", "rounds", "budgetCurrency", "budgetCents", "environmentMode", "brokerMode", "idempotencyKey"],
  "properties": {
    "fixtureId": { "type": "string", "minLength": 1 },
    "modelProfile": { "type": "string", "minLength": 1 },
    "rounds": { "type": "integer", "minimum": 1, "maximum": 3 },
    "budgetCurrency": { "const": "USD" },
    "budgetCents": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "environmentMode": { "const": "RESEARCH" },
    "brokerMode": { "const": "FAKE" },
    "idempotencyKey": { "type": "string", "minLength": 8 }
  }
}
