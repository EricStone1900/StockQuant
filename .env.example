# Local development template only. Do not put credentials in this file.
STOCKQUANT_ENVIRONMENT_MODE=PAPER
STOCKQUANT_BROKER_MODE=FAKE
STOCKQUANT_LIVE_TRADING_ENABLED=false
STOCKQUANT_BIND_HOST=127.0.0.1
STOCKQUANT_WEB_ORIGIN=http://127.0.0.1:3000
STOCKQUANT_ARTIFACT_ROOT=./artifacts/local
STOCKQUANT_COMPUTE_WORKERS=1

# Exact database names, users, ports and secret references are frozen in V1.1.
STOCKQUANT_DATABASE_HOST=127.0.0.1
STOCKQUANT_DATABASE_PORT=5432
STOCKQUANT_DATABASE_SSL_MODE=disable

# Provider/model credentials remain absent until their owning stage.
# Never add real broker configuration in V1-V3.
# V3.1 confirmed provider references (keep values only in ignored .env.local).
# DEEPSEEK_API_KEY=replace-in-.env.local
# SILICONFLOW_API_KEY=replace-in-.env.local
# Qwen3-Embedding-4B output dimension is fixed at 1024 for V3.1.
STOCKQUANT_RESEARCH_EMBEDDING_MODEL=litellm_proxy/Qwen/Qwen3-Embedding-4B
STOCKQUANT_RESEARCH_EMBEDDING_DIMENSIONS=1024
# Internal service authentication. Set distinct random values in ignored .env.local.
# Platform API uses its own service identity when calling Research Automation.
# Runner host uses its own STOCKQUANT_SERVICE_TOKEN_RUNNER_HOST credential.
STOCKQUANT_SERVICE_TOKEN_PLATFORM_API=
STOCKQUANT_SERVICE_TOKEN_RUNNER_HOST=
# Internal callers use separate credentials. Values are read by the matching
# caller and checked against route scopes by each service; keep them only in .env.local.
# Market Data minute CSV/Parquet import endpoints accept only the platform API identity.
STOCKQUANT_SERVICE_TOKEN_TRADE_EXECUTION=
STOCKQUANT_SERVICE_TOKEN_HISTORICAL_REPLAY=
# V3.2 Research Automation uses this identity to submit PromotionRequests to Quant and read
# the V3.1 acceptance gate from Platform; Platform validates it independently.
STOCKQUANT_SERVICE_TOKEN_RESEARCH_AUTOMATION=
# V3.2 immutable validation-report writer; distinct from request submitter and platform reader.
STOCKQUANT_SERVICE_TOKEN_QUANT_VALIDATION_WORKER=
STOCKQUANT_SERVICE_TOKEN_QUANT_RESEARCH_SERVICE=
# V3.2 Governance performs exact approved Registry lookups with its own read-only identity.
STOCKQUANT_SERVICE_TOKEN_DECISION_GOVERNANCE=
# Trade execution verifies both platform and replay callers with their own identities.
# Host-side Runner process is deliberately disabled by default. When separately authorized,
# set ISOLATED and an exact TestRun scope; run it on the host, never in the API container.
STOCKQUANT_RUNNER_HOST_MODE=NOT_CONFIGURED
STOCKQUANT_RUNNER_HOST_API_URL=http://127.0.0.1:3008
STOCKQUANT_RUNNER_HOST_WORKER_ID=runner-host-local-1
STOCKQUANT_RUNNER_HOST_TEST_RUN_ID=
STOCKQUANT_RUNNER_IMAGE_REF=
STOCKQUANT_RUNNER_MANAGED_ROOT=/var/lib/stockquant/runner-host
# Dedicated integration database; never point this at the live research database.
RESEARCH_AUTOMATION_DATABASE_URL=postgresql://research_automation@127.0.0.1:5433/research_automation_test
# Dedicated portfolio account reservation integration database; never use portfolio_risk.
PORTFOLIO_RISK_TEST_DATABASE_URL=postgresql://portfolio_risk@127.0.0.1:5433/portfolio_risk_test
# V3.1 budget policy (USD cents; no credentials or live calls enabled by these values).
STOCKQUANT_RESEARCH_BUDGET_CURRENCY=USD
STOCKQUANT_RESEARCH_DEFAULT_BUDGET_CENTS=300
STOCKQUANT_RESEARCH_MAX_EXPERIMENT_BUDGET_CENTS=1000
STOCKQUANT_RESEARCH_STAGE_BUDGET_CENTS=3000
STOCKQUANT_RESEARCH_BUDGET_WARNING_PERCENT=80

# Required for local collection control. Put the real value in .env.local, not Git.
STOCKQUANT_COLLECTION_CONTROL_TOKEN=replace-with-a-random-local-secret
STOCKQUANT_COLLECTION_SOURCES=sina,baostock
STOCKQUANT_COLLECTION_SOURCE_HEALTH_PATH=/var/lib/stockquant/source-health.json
STOCKQUANT_COLLECTION_PER_SECURITY_INTERVAL_SECONDS=0.2
STOCKQUANT_COLLECTION_SOURCE_BACKOFF_JITTER_SECONDS=0.5
STOCKQUANT_COLLECTION_SOURCE_RECOVERY_COOLDOWN_SECONDS=600
STOCKQUANT_COLLECTION_BAOSTOCK_INTERVAL_SECONDS=0.5
STOCKQUANT_COLLECTION_BAOSTOCK_BATCH_SIZE=5
# Optional easy-tdx candidate. Keep `STOCKQUANT_COLLECTION_SOURCES` unchanged
# until the real-source capability and observation gates pass.
STOCKQUANT_INSTALL_TDX=0
STOCKQUANT_COLLECTION_TDX_INTERVAL_SECONDS=1.0
STOCKQUANT_COLLECTION_TDX_BAR_COUNT=800
