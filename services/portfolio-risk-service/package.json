{
  "name": "@stockquant/portfolio-risk-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "pnpm build && PORTFOLIO_RISK_TEST_DATABASE_URL=\"${PORTFOLIO_RISK_TEST_DATABASE_URL:-postgresql://portfolio_risk@127.0.0.1:5433/portfolio_risk_test}\" vitest run tests/integration && node scripts/service-auth-http-smoke.mjs",
    "service-auth:http-smoke": "node scripts/service-auth-http-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
