{
  "name": "@stockquant/platform-api-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:v12-run-lifecycle": "pnpm build && vitest run tests/integration/v12-run-lifecycle.spec.ts",
    "test:v15-outbox-atomicity": "pnpm build && vitest run tests/integration/v15-outbox-atomicity.spec.ts",
    "test:v15-run-incidents": "pnpm build && vitest run tests/integration/v15-run-incidents.spec.ts",
    "test:v14-report-publication-fencing": "pnpm build && vitest run tests/integration/v14-report-publication-fencing.spec.ts",
    "dc06:project-delivery-http-smoke": "pnpm build && node scripts/market-data-project-delivery-http-smoke.mjs",
    "test:v24-observation-persistence": "pnpm build && node scripts/test-persistence.mjs && node scripts/test-v24-observation-persistence.mjs",
    "test:integration:persistence": "pnpm build && node scripts/test-persistence.mjs && node scripts/test-v24-observation-persistence.mjs && node scripts/test-legacy-test-run-migration.mjs && node scripts/test-legacy-stage-dual-store.mjs && node scripts/test-legacy-stage-http-smoke.mjs",
    "test:legacy-migration-rehearsal": "pnpm build && node scripts/rehearse-legacy-test-run-migration.mjs",
    "v11:legacy-shadow-migration": "pnpm build && node scripts/apply-legacy-test-run-shadow-migration.mjs --apply",
    "v31:artifact-owner-scope-http-smoke": "pnpm build && pnpm --filter @stockquant/research-automation-service build && node scripts/v31-artifact-owner-scope-http-smoke.mjs",
    "v31:fixed-pipeline-web-http-smoke": "pnpm build && pnpm --filter @stockquant/research-automation-service build && node scripts/v31-fixed-pipeline-web-http-smoke.mjs",
    "v22:upload-body-limit-smoke": "pnpm build && node scripts/v22-upload-body-limit-smoke.mjs",
    "v24:revision-web-http-smoke": "pnpm build && node scripts/v24-observation-revision-web-http-smoke.mjs",
    "v24:revision-container-smoke": "node scripts/v24-observation-revision-web-http-smoke.mjs --containerized",
    "v24:waiting-http-smoke": "pnpm --filter @stockquant/trade-execution-service build && pnpm build && node scripts/v24-waiting-http-smoke.mjs",
    "v22:upload-web-http-smoke": "pnpm --filter @stockquant/market-data-service build && pnpm build && node scripts/v22-upload-web-http-smoke.mjs",
    "v25:minute-import-run-smoke": "pnpm --filter @stockquant/market-data-service build && pnpm build && pnpm --filter @stockquant/web build && node ../../scripts/run-isolated-postgres-command.mjs --admin-env STOCKQUANT_V25_MINUTE_IMPORT_ADMIN_DATABASE_URL -- node scripts/v25-minute-import-run-http-smoke.mjs",
    "v24:paper-http-smoke": "pnpm --filter @stockquant/decision-governance-service build && pnpm --filter @stockquant/portfolio-risk-service build && pnpm --filter @stockquant/trade-execution-service build && pnpm --filter @stockquant/market-data-service build && pnpm build && node scripts/v24-paper-http-smoke.mjs",
    "v23:qlib-fixture-testrun-smoke": "pnpm --filter @stockquant/quant-research-service build && pnpm build && node scripts/v23-qlib-fixture-testrun-http-smoke.mjs",
    "v23:local-historical-replay-smoke": "node scripts/v23-local-historical-replay-http-smoke.mjs",
    "v23:qlib-legacy-backfill": "pnpm build && node scripts/backfill-qlib-legacy-payloads.mjs"
  },
  "dependencies": {
    "@stockquant/artifact-content-store": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@temporalio/client": "1.15.0",
    "@temporalio/worker": "1.15.0",
    "@temporalio/workflow": "1.15.0",
    "nats": "2.29.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
